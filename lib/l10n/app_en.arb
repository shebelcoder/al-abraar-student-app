  "help_faq1Q": "How do I join a live class?",
  "@help_faq1Q": { "description": "FAQ 1 question" },
  "help_faq1A": "Go to My Schedule and tap the 'Join' button on your upcoming session card. Make sure you're on time — the button becomes active 5 minutes before the class starts.",
  "@help_faq1A": { "description": "FAQ 1 answer" },
  "help_faq2Q": "How is my AI practice session scored?",
  "@help_faq2Q": { "description": "FAQ 2 question" },
  "help_faq2A": "The AI listens to your recitation and compares it to the reference text. You can also self-assess using the Correct / Small Mistake / Wrong buttons. Your score and accuracy are saved to your progress.",
  "@help_faq2A": { "description": "FAQ 2 answer" },
  "help_faq3Q": "How do I message my teacher?",
  "@help_faq3Q": { "description": "FAQ 3 question" },
  "help_faq3A": "Open the Messages tab from the bottom navigation. Tap on your teacher's name to open the conversation. All your teachers are listed there.",
  "@help_faq3A": { "description": "FAQ 3 answer" },
  "help_faq4Q": "What are badges and how do I earn them?",
  "@help_faq4Q": { "description": "FAQ 4 question" },
  "help_faq4A": "Badges are rewards for achieving milestones — like completing a surah, maintaining a streak, or getting a high score. Visit My Badges from your Profile to see what you can earn next.",
  "@help_faq4A": { "description": "FAQ 4 answer" },
  "help_faq5Q": "My attendance is marked incorrectly. What do I do?",
  "@help_faq5Q": { "description": "FAQ 5 question" },
  "help_faq5A": "Please contact your teacher directly via the Messages tab. They can update your attendance record. You can also raise it in class.",
  "@help_faq5A": { "description": "FAQ 5 answer" },
  "help_faq6Q": "How do I reset my password?",
  "@help_faq6Q": { "description": "FAQ 6 question" },
  "help_faq6A": "Go to Profile → Settings → Change Password. If you have forgotten your password, use the Forgot Password option on the login screen.",
  "@help_faq6A": { "description": "FAQ 6 answer" },
  "help_faq7Q": "Can I use the app without an internet connection?",
  "@help_faq7Q": { "description": "FAQ 7 question" },
  "help_faq7A": "Some features like your schedule and recent progress are available offline. However, live classes, AI practice, and messaging require an internet connection.",
  "@help_faq7A": { "description": "FAQ 7 answer" },
